default_platform(:ios)

# Prefer an App Store Connect API key (no 2FA prompts). Create a Team Key in
# App Store Connect -> Users and Access -> Integrations, then export:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_FILEPATH
def asc_api_key
  key_id = ENV["ASC_KEY_ID"]
  issuer_id = ENV["ASC_ISSUER_ID"]
  key_path = ENV["ASC_KEY_FILEPATH"]
  return nil if key_id.to_s.empty? || issuer_id.to_s.empty? || key_path.to_s.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

def signing_options(api_key, extra = {})
  options = extra.reject { |_, value| value.nil? || value.to_s.empty? }
  options[:api_key] = api_key if api_key
  options
end

def profile_path(profile)
  return profile[:output_path] if profile.is_a?(Hash) && profile[:output_path]
  return profile.first if profile.is_a?(Array)
  profile.to_s
end

def distribution_identity(team_id = nil)
  command = +"security find-identity -v -p codesigning | grep 'Apple Distribution'"
  command << " | grep '(#{team_id})'" unless team_id.to_s.empty?
  command << " | head -1 | sed -E 's/.*\"(.*)\"/\\1/'"
  sh(command).strip
end

platform :ios do
  desc "List Apple Developer teams for the current Apple ID"
  lane :teams do
    require "spaceship"
    Spaceship::Portal.login(ENV.fetch("FASTLANE_USER"))
    Spaceship::Portal.client.teams.each do |team|
      puts "#{team.team_id}\t#{team.name}"
    end
  end

  desc "Create an Apple Distribution certificate and an App Store provisioning profile"
  lane :setup_signing do
    api_key = asc_api_key
    team_id = ENV["TEAM_ID"]
    if team_id.to_s.empty? && api_key.nil?
      UI.user_error!("Set TEAM_ID (and/or App Store Connect API key env vars)")
    end

    app_id = ENV.fetch("BUNDLE_ID", "com.uiautodev.weektodo")
    user = ENV["FASTLANE_USER"]

    cert(**signing_options(api_key, { team_id: team_id, username: user }))
    profile = sigh(
      **signing_options(api_key, {
        team_id: team_id,
        app_identifier: app_id,
        username: user,
        readonly: false
      })
    )

    identity = distribution_identity(team_id)

    UI.success("Code signing identity: #{identity}")
    UI.success("Provisioning profile: #{profile_path(profile)}")
    UI.message("Use these with: make ios-ipa IOS_SIGN_IDENTITY=... IOS_PROVISIONING_PROFILE=...")
  end

  desc "Build the signed IPA and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key
    app_id = ENV.fetch("BUNDLE_ID", "com.uiautodev.weektodo")
    version = ENV.fetch("IOS_VERSION", "0.3.0")
    build = ENV.fetch("IOS_BUILD", "1")
    team_id = ENV["TEAM_ID"]
    user = ENV["FASTLANE_USER"]

    if api_key.nil? && user.to_s.empty?
      UI.user_error!("Set FASTLANE_USER or the App Store Connect API key env vars")
    end

    if ENV["IOS_SIGN_IDENTITY"].to_s.empty? || ENV["IOS_PROVISIONING_PROFILE"].to_s.empty?
      profile = sigh(
        **signing_options(api_key, {
          team_id: team_id,
          app_identifier: app_id,
          username: user,
          readonly: false
        })
      )
      identity = distribution_identity(team_id)
      UI.user_error!("No Apple Distribution identity found") if identity.empty?
      ENV["IOS_SIGN_IDENTITY"] = identity
      ENV["IOS_PROVISIONING_PROFILE"] = profile_path(profile)
    end

    sh(
      "make ios-ipa " \
      "IOS_SIGN_IDENTITY=#{Shellwords.escape(ENV['IOS_SIGN_IDENTITY'])} " \
      "IOS_PROVISIONING_PROFILE=#{Shellwords.escape(ENV['IOS_PROVISIONING_PROFILE'])} " \
      "IOS_VERSION=#{Shellwords.escape(version)} " \
      "IOS_BUILD=#{Shellwords.escape(build)}"
    )

    upload_options = signing_options(api_key, {
      ipa: "mobile/ios/bin/weektodo.ipa",
      skip_waiting_for_build_processing: true
    })
    upload_options[:username] = user if api_key.nil?
    upload_to_testflight(**upload_options)
  end
end
